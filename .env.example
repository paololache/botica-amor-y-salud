# Postgres (Neon desde el Marketplace de Vercel). Sin esta variable se usa una base embebida local (.pglite)
DATABASE_URL=
# Clave para firmar las sesiones (mínimo 32 caracteres)
AUTH_SECRET=cambia-esta-clave-por-una-larga-y-aleatoria
# Clave que Vercel Cron envía en Authorization: Bearer <CRON_SECRET>
CRON_SECRET=
# simulado = acepta los CPE sin conectarse a SUNAT (ambiente de pruebas)
SUNAT_MODO=simulado
# 1 = muestra los usuarios de prueba en la pantalla de ingreso. Pon 0 en producción.
NEXT_PUBLIC_MODO_PRUEBA=1
