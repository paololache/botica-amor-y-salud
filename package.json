    "jose": "6.2.13",
    "lucide-react": "1.61.0",
    "next": "15.5.28",
    "postgres": "3.4.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
